# Environment & secrets — NEVER commit these
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json

# Virtual environments
.venv/
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# MAYA runtime data (keep directory placeholders)
uploads/*
!uploads/.gitkeep
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep
backend/instance/
*.log

# Dataset blobs — keep scaffolding only (images stay local)
dataset/raw/*
!dataset/raw/README.md
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep
dataset/reports/*
!dataset/reports/.gitkeep
dataset/versions/**
!dataset/versions/.gitkeep
!dataset/versions/CURRENT

# Large local catalogue / downloads — do not push
archive/
archive.zip

# Local databases & model weights
*.db
*.sqlite3
*.pth
*.onnx
*.h5
*.ckpt
# Ignore .pt weights without a blanket *.pt rule. A blanket rule would also
# match the two production video checkpoints, which are explicit exceptions
# and must stay trackable:
#   artifacts/checkpoints/video/visual_model.pt
#   artifacts/checkpoints/video/lstm.pt
/*.pt
*/*.pt
*/*/*.pt

# Heavy / regenerable training artefacts (keep small docs if any).
# Ignore every checkpoint entry, then re-include only the production video directory.
artifacts/checkpoints/*
!artifacts/checkpoints/video/
artifacts/experiments/
artifacts/phase3/benchmark/_infer_scratch/
artifacts/phase3/sprint4/_infer_scratch/
# Regenerated every inference run — not source-controlled
artifacts/phase3/sprint4/*.json
artifacts/phase3/sprint4/*.md
artifacts/phase3/sprint4/*.txt
artifacts/phase3/sprint4/*.csv
artifacts/phase3/sprint4/*.png
artifacts/phase3/sprint4/*.jpg
artifacts/phase3/sprint4/*.jpeg
artifacts/phase3/sprint4/*.pdf
# Per-investigation forensic bundles — created at runtime by the backend
artifacts/investigations/*
!artifacts/investigations/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Ad-hoc test/debug output
test_output*.txt
test_result.txt
_diag_*.json

# Local collections and scratch files — do not commit
.postman/
postman/
dataset 16.09/
_tmp_thumb.jpg
