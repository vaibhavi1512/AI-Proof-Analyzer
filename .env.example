# MAYA local environment example
# Copy to `.env` and adjust. Never commit `.env`.

FLASK_ENV=development
# Required with FLASK_ENV=production: at least 16 chars and not a placeholder,
# or startup fails. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional. If omitted, MAYA uses backend/instance/maya.db
# DATABASE_URL=sqlite:///C:/path/to/maya/backend/instance/maya.db
LOG_LEVEL=INFO
ALLOW_PUBLIC_REGISTRATION=true
# Failed logins per client address, then HTTP 429 until the window passes.
# LOGIN_FAILURE_LIMIT=5
# LOGIN_FAILURE_WINDOW_SECONDS=60
# Registrations per client address.
# REGISTER_RATE_LIMIT=10
# REGISTER_RATE_WINDOW_SECONDS=60
# Evidence analysis starts per authenticated user.
# ANALYSIS_RATE_LIMIT=5
# VIDEO_ANALYSIS_RATE_LIMIT=3
# ANALYSIS_RATE_WINDOW_SECONDS=60
# Report emails per authenticated user. Separate from analysis limits.
# REPORT_EMAIL_LIMIT=5
# REPORT_EMAIL_WINDOW_SECONDS=60

# Outbound email for forensic PDF reports. Leave disabled until a mail
# server is available. Do not put a real password in this example file.
# MAIL_ENABLED=false
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=reports@example.com
# MAIL_USE_TLS=true
# MAX_CONTENT_LENGTH=16777216
# Production sends session cookies over HTTPS only. Set to false only when TLS
# is terminated by a proxy that cannot forward secure cookies.
# SESSION_COOKIE_SECURE=true

# Phase 5 — Face reference verification
# FACE_VERIFICATION_ENGINE=opencv
# Optional FaceNet (install with --no-deps only): FACE_VERIFICATION_ENGINE=facenet_pytorch
# FACE_VERIFICATION_MODEL=inception_resnet_v1
# FACE_VERIFICATION_MODEL_VERSION=vggface2
# FACE_VERIFICATION_PRETRAINED=vggface2
# FACE_VERIFICATION_DEVICE=cpu
# FACE_VERIFICATION_MATCH_THRESHOLD=0.70
# FACE_VERIFICATION_NO_MATCH_THRESHOLD=0.50
# FACE_VERIFICATION_MIN_FACE_SIZE=40
# FACE_VERIFICATION_MIN_SHARPNESS=25.0
# FACE_VERIFICATION_CACHE_DIR=

# Frozen 16-frame video model. Leave unset to use the checkpoints shipped in
# artifacts/checkpoints/video/. Set these only to point at a different copy.
# VIDEO_VISUAL_CHECKPOINT=
# VIDEO_LSTM_CHECKPOINT=
